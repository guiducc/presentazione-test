<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Motorcycle Presentation</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
        .screen { display: none; padding: 20px; }
        .active { display: block; }
    </style>
</head>
<body>
    <div id="screen-1" class="screen active">
        <h1>Welcome to the Motorcycle Presentation</h1>
        <button onclick="nextScreen(2)">Next</button>
    </div>
    <div id="screen-2" class="screen">
        <h2>Model Overview</h2>
        <p>Information about the motorcycle model.</p>
        <button onclick="nextScreen(3)">Next</button>
    </div>
    <div id="screen-3" class="screen">
        <h2>Features</h2>
        <p>Details about the features of the motorcycle.</p>
        <button onclick="nextScreen(4)">Next</button>
    </div>
    <div id="screen-4" class="screen">
        <h2>Safety Information</h2>
        <p>Important safety information.</p>
        <button onclick="nextScreen(5)">Next</button>
    </div>
    <div id="screen-5" class="screen">
        <h2>Thank You</h2>
        <p>End of the presentation.</p>
    </div>
    <script>
        function nextScreen(screenNumber) {
            const screens = document.querySelectorAll('.screen');
            screens.forEach(screen => screen.classList.remove('active'));
            document.getElementById('screen-' + screenNumber).classList.add('active');
        }
    </script>
</body>
</html>
